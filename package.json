{
  "name": "@eivmosn/utils",
  "type": "module",
  "version": "1.0.0",
  "description": "Common util collections for javascript and typescript",
  "author": "eivmosn <eivmosn@163.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eivmosn/utils.git"
  },
  "bugs": "https://github.com/eivmosn/utils/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./vue": "./dist/vue/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "build": "tsdown",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "oxlint && oxfmt --check",
    "hooks": "simple-git-hooks",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.52.0",
    "lunisolar": "^2.6.0",
    "nanoid": "^6.0.2"
  },
  "devDependencies": {
    "nano-staged": "^1.0.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.43"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged"
  },
  "nano-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": "oxlint --fix",
    "*.{ts,mts,cts,js,mjs,cjs,json,md,yml,yaml}": "oxfmt"
  }
}
