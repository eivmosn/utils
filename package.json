{
  "name": "@eivmosn/utils",
  "type": "module",
  "version": "1.0.6",
  "description": "Common util collections for javascript and typescript",
  "author": "eivmosn <eivmosn@163.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eivmosn/utils.git"
  },
  "bugs": "https://github.com/eivmosn/utils/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.cts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest",
    "build": "tsdown",
    "dev": "tsx src/index.ts",
    "postinstall": "npx simple-git-hooks",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.52.0",
    "lunisolar": "^2.6.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^25.9.8",
    "eslint": "^10.11.0",
    "nano-staged": "^0.9.0",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "unplugin-vue": "^7.2.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.43",
    "vue-tsc": "^3.2.0"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged"
  },
  "nano-staged": {
    "*.ts": "eslint --fix"
  }
}
